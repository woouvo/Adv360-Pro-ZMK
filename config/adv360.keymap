#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESCAPE    &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3          &kp NUMBER_4           &kp N5           &tog 3                                                     &mo 4      &kp NUMBER_6  &kp N7  &kp N8  &kp N9             &kp N0     &kp LEFT
&kp TAB       &kp SEMICOLON  &kp PLUS      &kp COMMA             &kp Y                  &kp SLASH        &kp LA(GRAVE)                                              &none      &kp V         &kp W   &kp P   &kp DOUBLE_QUOTES  &kp SQT    &kp UP_ARROW
&kp ESC       &kp A          &kp E         &kp O                 &kp I                  &mo 1            &none          &kp TAB        &kp LALT       &kp G  &kp M  &kp MINUS  &mo 1         &kp S   &kp N   &kp R              &kp H      &kp DOWN
&kp LEFT_WIN  &kp COLON      &kp DOLLAR    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EXCLAMATION                                &kp ENTER      &kp D                    &kp J         &kp C   &kp B   &kp X              &kp K      &kp RIGHT
&mo 4         &kp LCTRL      &kp LEFT_ALT  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                   &kp U          &kp BACKSPACE  &kp EQUAL      &kp F  &kp T  &kp L                    &kp Z   &kp Q   &kp RIGHT_ALT      &kp RCTRL  &mo 4
            >;
        };

        shift {
            display-name = "Base";
            bindings = <
&kp ESCAPE    &kp NUMBER_1  &kp NUMBER_2          &kp NUMBER_3   &kp LESS_THAN  &kp GREATER_THAN  &tog 3                                                                     &mo 4      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp N8     &kp N9          &kp N0     &kp LS(LEFT)
&kp TAB       &kp TILDE     &kp NON_US_BACKSLASH  &kp PERCENT    &kp LS(Y)      &kp ASTERISK      &kp LA(GRAVE)                                                              &none      &kp LS(V)       &kp LS(W)        &kp LS(P)  &kp UNDERSCORE  &kp GRAVE  &kp LS(UP_ARROW)
&kp ESC       &kp LS(A)     &kp LS(E)             &kp LS(O)      &kp LS(I)      &mo 0             &none          &kp LS(TAB)        &kp LS(LALT)       &kp LS(G)  &kp LS(M)  &kp MINUS  &mo 0           &kp LS(S)        &kp LS(N)  &kp LS(R)       &kp LS(H)  &kp LS(DOWN)
&kp LEFT_WIN  &kp PIPE      &kp AT_SIGN           &kp PERIOD     &kp QUESTION   &kp LS(NUMBER_3)                                    &kp LS(ENTER)      &kp LS(D)                        &kp LS(J)       &kp LS(C)        &kp LS(B)  &kp LS(X)       &kp LS(K)  &kp LS(RIGHT)
&mo 3         &kp LCTRL     &kp LEFT_ALT          &kp AMPERSAND  &kp CARET                        &kp LS(U)      &kp LS(BACKSPACE)  &kp EQUAL          &kp LS(F)  &kp LS(T)  &kp LS(L)                  &kp LS(Z)        &kp LS(Q)  &kp RIGHT_ALT   &kp RCTRL  &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4      &kp N6  &kp N7  &kp N8     &kp N9            &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O             &kp P          &kp NON_US_BACKSLASH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L             &kp SEMICOLON  &kp SQT
&kt LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp PERIOD        &kp SLASH      &kp RSHFT
&mo 4      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP  &kp DOWN   &kp LEFT_BRACKET  &kp RBKT       &mo 4
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2      &kp F3  &kp F4  &kp F5  &kp F6  &tog 3                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &caps_word  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        alpha {
            display-name = "Base";
            bindings = <
&kp PERCENT  &kp N1         &kp N2         &kp N3            &kp N4             &kp N5         &tog 3                                                        &mo 4               &kp N6           &kp N7                &kp N8                 &kp N9            &kp N0             &kp EQUAL
&kp TAB      &kp PIPE       &kp LESS_THAN  &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp SQT        &kp LA(GRAVE)                                                 &none               &kp GRAVE        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERCENT       &kp ASTERISK       &kp SLASH
&kp ESC      &kp AMPERSAND  &kp PERIOD     &kp EQUAL         &kp COLON          &kp SEMICOLON  &none          &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &kp RS(UNDERSCORE)  &kp EXCLAMATION  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PLUS          &kp MINUS          &kp NON_US_BACKSLASH
&mo 6        &kp DOLLAR     &kp HASH       &kp CARET         &kp AT_SIGN        &trans                                   &mo 0         &kp PG_UP                                 &kp TILDE        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LEFT_BRACE    &kp RIGHT_BRACE    &mo 0
&mo 4        &kp TILDE      &kp CAPS       &kp LEFT          &kp RIGHT                         &kp BSPC       &kp DEL    &mo 0         &kp PG_DN  &kp ENTER  &kp SPACE                            &kp UP                &kp DOWN               &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mo 4
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        test {
            if-layers = <6>;
            then-layer = <6>;
        };
    };
};
