#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
    };

    macros {
        m00: macro00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "put00";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp LA(GRAVE)  &kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5           &tog 3                                                                       &mo 4                  &kp NUMBER_6  &kp N7  &kp N8     &kp N9         &kp N0     &kp LEFT
&kp TAB        &kp SEMICOLON  &kp Y         &kp H         &kp U         &kp SLASH        &kp LESS_THAN                                                                &kp GREATER_THAN       &kp V         &kp W   &kp Z      &kp P          &kp SQT    &kp UP_ARROW
&kp ESC        &kp A          &kp I         &kp O         &kp E         &kp COMMA        &kp LEFT_PARENTHESIS  &kp TAB        &kp LCTRL             &kp G  &kp M      &kp RIGHT_PARENTHESIS  &kp K         &kp T   &kp S      &kp N          &kp R      &kp DOWN
&mo 1          &kp COLON      &kp MINUS     &kp EQUAL     &kp PLUS      &kp EXCLAMATION                                       &kp LEFT_COMMAND      &kp D                                    &kp J         &kp C   &kp B      &kp L          &kp Q      &kp RIGHT
&mo 3          &kp LCTRL      &kp LEFT_ALT  &kp MINUS     &kp SLASH                      &mo 1                 &kp BACKSPACE  &tog 2                &kp F  &kp ENTER  &mo 5                                &kp X   &kp TILDE  &kp RIGHT_ALT  &kp RCTRL  &mo 1
            >;
        };

        shift {
            display-name = "Base";
            bindings = <
&kp ESCAPE    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp LESS_THAN  &kp GREATER_THAN  &tog 3                                                                                     &mo 4                &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp N8           &kp N9         &kp N0     &kp LS(LEFT)
&kp TAB       &kp TILDE     &kp LS(Y)     &kp LS(H)      &kp LS(U)      &kp ASTERISK      &kp LEFT_BRACKET                                                                           &kp RIGHT_BRACKET    &kp LS(V)       &kp LS(W)        &kp LS(Z)        &kp LS(P)      &kp GRAVE  &kp LS(UP_ARROW)
&kp ESC       &kp LS(A)     &kp LS(I)     &kp LS(O)      &kp LS(E)      &kp PERIOD        &kp LS(LEFT_BRACE)  &kp LS(TAB)        &kp LCTRL                 &kp LS(G)  &kp LS(M)      &kp LS(RIGHT_BRACE)  &kp LS(K)       &kp LS(T)        &kp LS(S)        &kp LS(N)      &kp LS(R)  &kp LS(DOWN)
&kp LEFT_WIN  &kp PIPE      &kp AT_SIGN   &kp HASH       &kp QUESTION   &kp LS(NUMBER_3)                                         &kp LS(LEFT_COMMAND)      &kp LS(D)                                      &kp LS(J)       &kp LS(C)        &kp LS(B)        &kp LS(L)      &kp LS(Q)  &kp LS(RIGHT)
&mo 4         &kp LCTRL     &kp LEFT_ALT  &kp AMPERSAND  &kp CARET                        &kp LS(BACKSPACE)   &kp LS(BACKSPACE)  &tog 2                    &kp LS(F)  &kp LS(ENTER)  &kp LS(SPACE)                        &kp LS(X)        &kp LS(PERCENT)  &kp RIGHT_ALT  &kp RCTRL  &mo 4
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4      &kp N6  &kp N7  &kp N8     &kp N9            &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O             &kp P          &kp NON_US_BACKSLASH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &tog 0        &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L             &kp SEMICOLON  &kp SQT
&kt LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp PERIOD        &kp SLASH      &kp RSHFT
&mo 4      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &tog 0        &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP  &kp DOWN   &kp LEFT_BRACKET  &kp RBKT       &mo 4
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2      &kp F3  &kp F4  &kp F5  &kp F6  &tog 3                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &caps_word  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        alpha {
            display-name = "Base";
            bindings = <
&kp PERCENT  &kp N1      &kp N2         &kp N3             &kp N4             &kp N5                &tog 3                                                         &mo 4               &kp N6           &kp EQUAL     &kp SLASH     &kp N9        &kp N0             &kp EQUAL
&kp TAB      &kp PIPE    &kp LESS_THAN  &kp GREATER_THAN   &kp DOUBLE_QUOTES  &kp SQT               &kp LA(GRAVE)                                                  &none               &kp GRAVE        &kp N7        &kp N8        &kp N9        &kp ASTERISK       &kp SLASH
&kp ESC      &kp COLON   &kp SEMICOLON  &kp DOUBLE_QUOTES  &kp SQT            &kp NON_US_BACKSLASH  &none          &kp DELETE  &kp LALT      &kp LGUI   &kp RCTRL  &kp RS(UNDERSCORE)  &kp EXCLAMATION  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS          &kp NON_US_BACKSLASH
&mo 6        &kp DOLLAR  &kp HASH       &kp CARET          &kp AT_SIGN        &trans                                           &mo 0         &kp PG_UP                                 &kp TILDE        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS           &mo 0
&mo 4        &kp TILDE   &kp CAPS       &kp LEFT           &kp RIGHT                                &kp SPACE      &kp DELETE  &mo 0         &kp PG_DN  &kp ENTER  &kp SPACE                            &kp N0        &m00          &kp PERIOD    &kp RIGHT_BRACKET  &mo 4
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        test {
            if-layers = <6>;
            then-layer = <6>;
        };
    };
};
