#include <dt-bindings/zmk/stp.h>
#include <behaviors/naginata.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        as_ht: as_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "AS_HT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    macros {
        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RC(RA(RS(N)))>, <&macro_tap>, <&to 7>;
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp RS(RA(RC(F)))>, <&macro_tap>, <&to 0>;
        };

        m00: macro00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N0 &kp N0>;
            label = "put00";
        };

        as: as {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "AS";
        };

        test_t: test_t {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;

            label = "TEST_T";
        };

        nihon: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "NEW_MACRO";
        };

        ltsst: ciccogg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp LESS_THAN>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "CICCO";
        };

        get: get {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GREATER_THAN>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "GET";
        };

        cicco: cicco {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp LEFT_PARENTHESIS>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "CICCO";
        };

        cicccor: cicccor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp RIGHT_PARENTHESIS>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "CICCCOR";
        };

        quest: quest {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp QUESTION>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "QUEST";
        };

        biccuri: biccuri {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp EXCLAMATION>,
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "BICCURI";
        };
    };

    combos {
        compatible = "zmk,combos";

        shift_u {
            bindings = <&kp LS(U)>;
            key-positions = <66 65>;
            layers = <0 1>;
        };

        space_combo {
            bindings = <&kp SPACE>;
            key-positions = <69 70>;
            layers = <0 1 2 3 7 8>;
        };

        m {
            bindings = <&kp M>;
            key-positions = <69 68>;
            layers = <0>;
        };

        Mm {
            bindings = <&kp LS(M)>;
            key-positions = <68 69>;
            layers = <1>;
        };

        g {
            bindings = <&kp G>;
            key-positions = <53 69>;
            layers = <0>;
            slow-release;
            timeout-ms = <180>;
            require-prior-idle-ms = <0>;
        };

        gg {
            bindings = <&kp LS(G)>;
            key-positions = <53 69>;
            layers = <1>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <23 41>;
            layers = <0>;
        };

        bb {
            bindings = <&kp LS(B)>;
            key-positions = <23 41>;
            layers = <1>;
        };

        j {
            bindings = <&kp K>;
            key-positions = <24 42>;
            layers = <0>;
        };

        x {
            bindings = <&kp X>;
            key-positions = <25 43>;
            layers = <0>;
        };

        q {
            bindings = <&kp J>;
            key-positions = <40 41>;
            layers = <0>;
        };

        jj {
            bindings = <&kp LS(K)>;
            key-positions = <24 42>;
            layers = <1>;
        };

        xx {
            bindings = <&kp LS(X)>;
            key-positions = <25 43>;
            layers = <1>;
        };

        qq {
            bindings = <&kp LS(J)>;
            key-positions = <40 41>;
            layers = <1>;
        };

        nb {
            bindings = <&kp LS(PERIOD)>;
            key-positions = <23 41>;
            layers = <8>;
        };

        eoiaeh {
            bindings = <&kp Y>;
            key-positions = <24 42>;
            layers = <7>;
        };

        oiaaa {
            bindings = <&kp COMMA>;
            key-positions = <24 42>;
            layers = <8>;
        };

        ieoioeh {
            bindings = <&kp U>;
            key-positions = <23 41>;
            layers = <7>;
        };

        ioeaioe {
            bindings = <&kp Q>;
            key-positions = <40 41>;
            layers = <7>;
        };

        fdg66666 {
            bindings = <&kp NUMBER_6>;
            key-positions = <40 41>;
            layers = <8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Defalt";
            bindings = <
&nihon            &kp NUMBER_1  &kp NUMBER_2          &kp NUMBER_3  &kp NUMBER_4  &kp N5           &tog 3                                                            &mo 5                  &kp NUMBER_6  &kp N7    &kp N8        &kp N9         &kp N0     &kp LEFT
&kp TAB           &kp GRAVE     &kp NON_US_BACKSLASH  &kp H         &kp Y         &kp SLASH        &kp LESS_THAN                                                     &kp GREATER_THAN       &kp V         &kp W     &kp Z         &kp P          &kp Q      &kp UP_ARROW
&kp ESC           &kp A         &kp I                 &kp O         &kp E         &kp PERIOD       &kp LEFT_PARENTHESIS  &kp TAB  &to 6        &kp G  &kp BACKSPACE  &kp RIGHT_PARENTHESIS  &kp L         &kp T     &kp C         &kp N          &kp R      &kp DOWN
&kp LEFT_CONTROL  &kp COLON     &kp PLUS              &kp EQUAL     &kp MINUS     &kp EXCLAMATION                                 &ng_on       &kp D                                        &kp LEFT      &kp DOWN  &kp UP_ARROW  &kp RIGHT      &kp END    &kp RIGHT
&mo 4             &kp LEFT_WIN  &kp LEFT_ALT          &kp MINUS     &kp SLASH                      &mo 1                 &kp U    &ng_off      &kp F  &kp S          &mo 2                                &kp HOME  &kp TILDE     &kp RIGHT_ALT  &kp RCTRL  &mo 1
            >;
        };

        shift {
            display-name = "Shift";
            bindings = <
&kp NON_US_HASH  &kp NUMBER_1  &kp NUMBER_2          &kp NUMBER_3   &kp LESS_THAN  &kp GREATER_THAN  &tog 3                                                                               &mo 6                &kp LEFT_BRACE      &kp RIGHT_BRACE   &kp N8           &kp N9         &kp N0     &kp LS(LEFT)
&kp TAB          &kp TILDE     &kp LS(SINGLE_QUOTE)  &kp LS(H)      &kp LS(Y)      &kp ASTERISK      &kp LEFT_BRACKET                                                                     &kp RIGHT_BRACKET    &kp LS(V)           &kp LS(W)         &kp LS(Z)        &kp LS(P)      &kp LS(Q)  &kp LS(UP_ARROW)
&kp ESC          &kp LS(A)     &kp LS(I)             &kp LS(O)      &kp LS(E)      &kp COMMA         &kp LS(LEFT_BRACE)  &kp LS(TAB)  &kp LCTRL                 &kp LS(G)  &kp BACKSPACE  &kp LS(RIGHT_BRACE)  &kp LS(L)           &kp LS(T)         &kp LS(C)        &kp LS(N)      &kp LS(R)  &kp LS(DOWN)
&kp LCTRL        &kp PIPE      &kp UNDERSCORE        &kp PERCENT    &kp DOLLAR     &kp QMARK                                          &kp LS(LEFT_COMMAND)      &kp LS(D)                                      &kp LS(LEFT_ARROW)  &kp LS(UP_ARROW)  &kp LS(DOWN)     &kp LS(RIGHT)  &kp LS(Q)  &kp LS(RIGHT)
&mo 6            &kp LEFT_WIN  &kp LEFT_ALT          &kp AMPERSAND  &kp CARET                        &kp LS(BACKSPACE)   &kp LS(U)    &to 0                     &kp LS(F)  &kp LS(S)      &kp LS(ENTER)                            &kp LS(X)         &kp LS(PERCENT)  &kp RIGHT_ALT  &kp RCTRL  &mo 6
            >;
        };

        alpha {
            display-name = "alpha";
            bindings = <
&trans   &kp N1               &kp N2               &kp N3             &kp N4     &kp N5         &tog 3                                                             &mo 6               &kp N6     &kp EQUAL     &kp SLASH     &kp N9        &kp N0             &kp EQUAL
&kp TAB  &kp HASH             &kp LESS_THAN        &kp GREATER_THAN   &kp CARET  &kp DOLLAR     &kp C_AC_COPY                                                      &none               &kp GRAVE  &kp N7        &kp N8        &kp N9        &kp ASTERISK       &kp SLASH
&kp ESC  &kp COLON            &kp SEMICOLON        &kp DOUBLE_QUOTES  &kp SQT    &kp PIPE       &kp C_AC_PASTE  &kp DELETE     &kp LALT      &kp LGUI   &kp RCTRL  &kp RS(UNDERSCORE)  &kp SLASH  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS          &kp NON_US_BACKSLASH
&mo 0    &kp INTERNATIONAL_4  &kp INTERNATIONAL_5  &kp INT2           &trans     &kp AMPERSAND                                 &mo 0         &kp PG_UP                                 &kp TILDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS           &mo 0
&mo 6    &kp TILDE            &kp CAPS             &kp LEFT           &kp RIGHT                 &kp ENTER       &kp BACKSPACE  &to 0         &kp PG_DN  &kp ENTER  &kp SPACE                      &kp N0        &m00          &kp PERIOD    &kp RIGHT_BRACKET  &mo 6
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp GRAVE  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 6      &kp N6  &kp N7  &kp N8     &kp N9            &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O             &kp P          &kp NON_US_BACKSLASH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &tog 0        &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L             &kp SEMICOLON  &kp SQT
&kt LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp PERIOD        &kp SLASH      &kp RSHFT
&mo 6      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &nihon        &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LEFT_BRACKET  &kp RBKT       &mo 6
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2      &kp F3  &kp F4  &kp F5  &kp F6  &tog 3                                      &mo 6   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &caps_word  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans          &trans  &trans  &mo 0       &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &bl BL_ON        &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &trans        &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &mo 0      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        mouse {
            bindings = <
&trans  &trans          &trans          &trans        &trans          &trans           &trans                                                        &trans     &trans          &trans          &trans        &trans           &trans            &trans
&trans  &trans          &trans          &trans        &trans          &trans           &trans                                                        &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mmv MOVE_RIGHT   &trans
&trans  &msc SCRL_LEFT  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans          &trans  &trans      &trans         &mkp MCLK  &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mmv MOVE_X(600)  &trans
&trans  &trans          &trans          &trans        &trans          &trans                                   &trans      &kp PAGE_UP                          &trans          &none           &trans        &trans           &trans            &trans
&trans  &trans          &trans          &trans        &trans                           &kp LEFT_SHIFT  &none   &to 0       &kp PAGE_DOWN  &mkp LCLK  &mkp RCLK                  &trans          &trans        &trans           &trans            &trans
            >;
        };

        new_nagi {
            display-name = "new_nagi";
            bindings = <
&kp GRAVE  &kp N1          &kp N2        &kp N3    &kp N4     &kp N5       &trans                                                               &mo 5     &kp N6         &kp N7        &kp N8        &kp N9            &kp N0          &kp MINUS
&kp TAB    &kp LEFT_SHIFT  &kp G         &kp W     &kp D      &kp AT_SIGN  &ltsst                                                               &get      &kp SEMICOLON  &kp O         &kp PERIOD    &kp R             &kp EQUAL       &kp NON_US_BACKSLASH
&kp ESC    &kp GRAVE       &kp SQT       &kp S     &kp T      &kp LS(Z)    &cicco  &kp LCTRL          &tog 0       &kp LGUI   &kp BACKSPACE     &cicccor  &kp H          &kp NUMBER_3  &kp E         &kp NUMBER_4      &kp UNDERSCORE  &kp SQT
&kt RCTRL  &kp MINUS       &kp V         &kp F     &kp B      &kp C                                   &ng_on       &kp PG_UP                              &kp LEFT       &kp DOWN      &kp UP_ARROW  &kp RIGHT         &kp SLASH       &kp RSHFT
&mo 6      &kp LEFT_WIN    &kp LEFT_ALT  &kp LEFT  &kp RIGHT               &mo 8   &kp RIGHT_BRACKET  &ng_off      &kp PG_DN  &kp LEFT_BRACKET  &mo 9                    &kp UP        &kp DOWN      &kp LEFT_BRACKET  &kp RBKT        &mo 6
            >;
        };

        nagi_shift {
            display-name = "nagi_shift";
            bindings = <
&kp GRAVE  &kp N1          &kp N2        &kp N3      &kp N4         &kp N5                &trans                                                             &mo 6  &kp N6    &kp N7    &kp N8        &kp N9            &kp N0        &kp MINUS
&kp TAB    &kp LEFT_SHIFT  &kp NUMBER_1  &kp L       &kp SLASH      &kp T                 &biccuri                                                           &none  &kp N0    &kp X     &kp N9        &kp N5            &kp N8        &kp NON_US_BACKSLASH
&kp ESC    &kp P           &kp N         &kp I       &kp J          &kp A                 &quest     &kp LCTRL    &tog 0        &kp LGUI   &kp BACKSPACE     &none  &kp N7    &kp K     &kp M         &kp Z             &kp NUMBER_2  &kp SQT
&kt RCTRL  &kp MINUS       &kp V         &kp LS(N0)  &kp LS(COMMA)  &kp NON_US_BACKSLASH                          &kp HOME      &kp PG_UP                           &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT         &kp SLASH     &kp RSHFT
&mo 6      &kp LEFT_WIN    &kp LEFT_ALT  &kp LEFT    &kp RIGHT                            &kp ENTER  &kp AT_SIGN  &nihon        &kp PG_DN  &kp LEFT_BRACKET  &mo 8            &kp UP    &kp DOWN      &kp LEFT_BRACKET  &kp RBKT      &mo 6
            >;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &kp ENTER  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_12 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
