#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp PERCENT  &kp N1         &kp N2         &kp N3            &kp N4     &kp N5  &tog 1                                                        &mo 3      &kp N6  &kp N7  &kp N8    &kp N9     &kp N0     &kp GRAVE
&kp TAB      &kp SEMICOLON  &kp LESS_THAN  &kp GREATER_THAN  &kp P      &kp Y   &kp LA(GRAVE)                                                 &none      &kp F   &kp G   &kp C     &kp R      &kp L      &kp SLASH
&kp ESC      &kp A          &kp O          &kp E             &kp U      &kp I   &none          &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp D   &kp H   &kp T     &kp N      &kp S      &kp NON_US_BACKSLASH
&mo 4        &kp SQT        &kp Q          &kp J             &kp K      &kp X                             &kp HOME      &kp PG_UP                        &kp B   &kp M   &kp W     &kp V      &kp Z      &kp RSHFT
&mo 2        &kp GRAVE      &kp CAPS       &kp LEFT          &kp RIGHT          &kp BSPC       &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN  &kp CARET  &kp MINUS  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp N7  &kp N8     &kp N9            &kp N0         &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O             &kp P          &kp NON_US_BACKSLASH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L             &kp SEMICOLON  &kp SQT
&kt LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp M   &kp COMMA  &kp PERIOD        &kp SLASH      &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP  &kp DOWN   &kp LEFT_BRACKET  &kp RBKT       &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2      &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &caps_word  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        shift {
            display-name = "Base";
            bindings = <
&kp AMPERSAND   &kp LEFT_BRACKET   &kp LEFT_BRACE     &kp RIGHT_BRACE       &kp LEFT_PARENTHESIS  &kp EQUAL  &tog 1                                                                        &mo 3          &kp ASTERISK  &kp RIGHT_PARENTHESIS  &kp PLUS      &kp RIGHT_BRACKET  &kp EXCLAMATION     &kp HASH
&kp LS(TAB)     &kp LS(SEMICOLON)  &kp LS(LESS_THAN)  &kp LS(GREATER_THAN)  &kp LS(P)             &kp LS(Y)  &kp LA(GRAVE)                                                                 &none          &kp LS(F)     &kp LS(G)              &kp LS(C)     &kp LS(R)          &kp LS(L)           &kp LS(SLASH)
&kp LS(ESC)     &kp LS(A)          &kp LS(O)          &kp LS(E)             &kp LS(U)             &kp LS(I)  &none          &kp LS(LCTRL)  &kp LS(LALT)      &kp LS(LGUI)   &kp LS(RCTRL)  &none          &kp LS(D)     &kp LS(H)              &kp LS(T)     &kp LS(N)          &kp LS(S)           &kp LS(NON_US_BACKSLASH)
&kp LEFT_SHIFT  &kp LS(SQT)        &kp LS(Q)          &kp LS(J)             &kp LS(K)             &kp LS(X)                                &kp LS(HOME)      &kp LS(PG_UP)                                &kp LS(B)     &kp LS(M)              &kp LS(W)     &kp LS(V)          &kp LS(Z)           &kp RSHFT
&mo 2           &kp LS(GRAVE)      &kp LS(CAPS)       &kp LS(LEFT)          &kp LS(RIGHT)                    &kp LS(BSPC)   &kp LS(DEL)    &kp LS(END)       &kp LS(PG_DN)  &kp LS(ENTER)  &kp LS(SPACE)                &kp LS(UP)             &kp LS(DOWN)  &kp AT             &kp LS(UNDERSCORE)  &mo 2
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        test {
            if-layers = <5>;
            then-layer = <5>;
        };
    };
};
